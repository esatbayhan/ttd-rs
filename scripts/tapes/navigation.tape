Require target/release/ttd

Output docs/screenshots/tui-navigate.gif
Set Width 960
Set Height 540
Set FontSize 16
Set Framerate 24
Set PlaybackSpeed 0.8

Hide
Type "clear"
Enter
Show

Type "./target/release/ttd --task-dir demo-data/todo.txt.d"
Enter
Sleep 1.5s

Type "j"
Sleep 300ms
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms

Type "l"
Sleep 300ms
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms
Type "k"
Sleep 300ms

Type "h"
Sleep 300ms
Type "j"
Sleep 300ms
Type "j"
Sleep 300ms

Type "l"
Sleep 300ms
Type "j"
Sleep 200ms
Type "j"
Sleep 200ms
Type "j"
Sleep 200ms

Type "q"
Sleep 200ms
